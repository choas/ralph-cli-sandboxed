{
  "name": "ralph-cli-sandboxed",
  "version": "0.7.2",
  "description": "AI-driven development automation CLI for Claude Code",
  "type": "module",
  "bin": {
    "ralph": "dist/index.js",
    "ralph-cli-sandboxed": "dist/index.js",
    "ralph-mcp": "dist/mcp-server.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && npm run copy-config",
    "copy-config": "mkdir -p dist/config && cp src/config/*.json dist/config/",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/",
    "format": "oxfmt src/",
    "format:check": "oxfmt --check src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.97.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@slack/bolt": "4.7.2",
    "@slack/web-api": "7.16.0",
    "discord.js": "14.26.4",
    "ink": "7.0.3",
    "ink-text-input": "6.0.0",
    "openai": "6.38.0",
    "react": "19.2.6",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "oxfmt": "0.51.0",
    "oxlint": "1.66.0",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  },
  "keywords": [
    "cli",
    "claude",
    "claude-code",
    "ai",
    "automation",
    "prd",
    "anthropic",
    "llm",
    "developer-tools",
    "devtools"
  ],
  "author": "Lars Gregori",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/choas/ralph-cli-sandboxed.git"
  },
  "homepage": "https://github.com/choas/ralph-cli-sandboxed#readme",
  "bugs": {
    "url": "https://github.com/choas/ralph-cli-sandboxed/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "undici": "^6.23.0"
  }
}
